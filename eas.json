{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_MAPBOX_TOKEN": "pk.your-token-here",
        "EXPO_PUBLIC_SAFETY_API_URL": "http://192.168.0.6:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MAPBOX_TOKEN": "pk.your-token-here",
        "EXPO_PUBLIC_SAFETY_API_URL": "http://192.168.0.6:8000"
      }
    },
    "production": {
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
