# Copy this file to `.env` and fill in the values you need.
# `.env` itself is gitignored - NEVER commit real keys.

# ── Optional: Mapbox (routing) ──────────────────────────────────────────
# Mapbox is an OPTIONAL routing provider used by lib/location.js. When it is
# absent the app falls back to OSRM, so you can leave this blank.
# NOTE: the map tiles themselves come from OpenStreetMap / CartoDB, not Mapbox.
EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Backend API (required on a physical device) ─────────────────────────
# lib/config.js reads EXPO_PUBLIC_SAFETY_API_URL. It also still accepts the
# older EXPO_PUBLIC_SAFETY_API, but _URL is the name to use.
#
# On a physical phone "localhost" is the PHONE, not your PC, so the safety
# engine is unreachable unless you point this at your machine's LAN IP.
# Find it: `ipconfig` on Windows, look for IPv4 under the Wi-Fi adapter.
# Example: EXPO_PUBLIC_SAFETY_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_SAFETY_API_URL=http://YOUR_PC_LAN_IP:8000

# ── Supabase (authentication) ───────────────────────────────────────────
# Values come from Supabase Dashboard -> Project Settings -> API.
#
# IMPORTANT
#  * Never put real keys in THIS file. It is committed to git; only `.env`
#    is gitignored.
#  * Use the PUBLISHABLE key only. Never put the legacy `service_role` /
#    secret key anywhere in an app: it bypasses Row Level Security and would
#    expose every row in your database to every device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where Supabase sends a user after they click a password-reset link.
# Must also be listed in Supabase -> Authentication -> URL Configuration.
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=myapp://auth/reset
