EXPO_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_access_token

# ── Supabase (authentication) ───────────────────────────────────────────
# Copy this file to `.env` and paste your real values from
# Supabase Dashboard -> Project Settings -> API.
#
#   Project URL       -> EXPO_PUBLIC_SUPABASE_URL
#   Publishable key   -> EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#                        (Project Settings -> API -> "Publishable key")
#
# IMPORTANT
#  * Never put real keys in THIS file. It is committed to git; only `.env`
#    is gitignored.
#  * Use the PUBLISHABLE key only. Never put the legacy `service_role`
#    / secret key anywhere in an app. It bypasses Row Level Security and
#    would expose every row in your database to every device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where Supabase sends a user after they click a password-reset link.
# Must also be listed in Supabase -> Authentication -> URL Configuration.
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=myapp://auth/reset

# ── Backend API (required for APK on physical device) ──────────────────
# When running the APK on a physical phone, set this to your PC's LAN IP.
# To find it: run `ipconfig` on Windows, then look for IPv4 under
# "Wi-Fi Adapter".
# Example: EXPO_PUBLIC_SAFETY_API_URL=http://192.168.1.42:8000
# Leave blank if you only use the web version.
EXPO_PUBLIC_SAFETY_API_URL=http://YOUR_PC_LAN_IP:8000
