EXPO_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_access_token

# Base URL of the SafeHer Safety Engine (FastAPI). Defaults to http://localhost:8000.
# On a physical device, set this to your computer's LAN IP so the phone can reach the engine:
#   EXPO_PUBLIC_SAFETY_API=http://192.168.1.20:8000
EXPO_PUBLIC_SAFETY_API=http://localhost:8000
